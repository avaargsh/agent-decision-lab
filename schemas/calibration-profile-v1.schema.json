{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/avaargsh/agent-decision-lab/schemas/calibration-profile-v1.schema.json",
  "title": "Sealed choice calibration profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "profile_id", "content_digest",
    "adapter", "model_ref", "decision_type", "candidate_schema_version",
    "inventory_sha256", "calibration", "method", "temperature",
    "execute_threshold", "margin_threshold", "risk_budget",
    "threshold_selection"
  ],
  "properties": {
    "schema_version": {"const": "calibration-profile/v1"},
    "profile_id": {
      "type": "string",
      "pattern": "^calibration-profile:sha256:[a-f0-9]{64}$"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "adapter": {"type": "string", "minLength": 1},
    "model_ref": {"type": "string", "minLength": 1},
    "decision_type": {"type": "string", "minLength": 1},
    "candidate_schema_version": {"const": "candidate-set/v1"},
    "inventory_sha256": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "case_count", "case_ids"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "case_count": {"type": "integer", "minimum": 1},
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "method": {"const": "temperature_scaling"},
    "temperature": {"type": "number", "exclusiveMinimum": 0},
    "execute_threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "margin_threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "risk_budget": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "threshold_selection": {
      "enum": [
        "calibration_risk_budget",
        "calibration_median_confidence_fallback"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "threshold_selection": {"const": "calibration_risk_budget"}
        },
        "required": ["threshold_selection"]
      },
      "then": {"properties": {"risk_budget": {"type": "number"}}}
    }
  ]
}
