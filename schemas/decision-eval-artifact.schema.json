{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/avaargsh/agent-decision-lab/schemas/decision-eval-artifact.schema.json",
  "title": "Decision Eval Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "content_digest",
    "decision_type",
    "adapter",
    "dataset",
    "metrics",
    "fallback_evaluation"
  ],
  "properties": {
    "schema_version": {
      "const": "decision-eval/v1"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^decision-eval:sha256:[0-9a-f]{64}$"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decision_type": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "type": "string",
      "minLength": 1
    },
    "model_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "calibration_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "case_count",
        "case_ids"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accuracy",
        "macro_f1",
        "nll",
        "brier",
        "ece",
        "mean_latency_ms",
        "p50_latency_ms",
        "p95_latency_ms",
        "mean_tokens_processed_per_decision"
      ],
      "properties": {
        "accuracy": {
          "type": "number"
        },
        "macro_f1": {
          "type": "number"
        },
        "nll": {
          "type": "number"
        },
        "brier": {
          "type": "number"
        },
        "ece": {
          "type": "number"
        },
        "mean_latency_ms": {
          "type": "number"
        },
        "p50_latency_ms": {
          "type": "number"
        },
        "p95_latency_ms": {
          "type": "number"
        },
        "mean_tokens_processed_per_decision": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "operating_point": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "threshold",
        "coverage",
        "risk",
        "false_automation_rate",
        "fallback_rate",
        "risk_budget"
      ],
      "properties": {
        "threshold": {
          "type": "number"
        },
        "coverage": {
          "type": "number"
        },
        "risk": {
          "type": "number"
        },
        "false_automation_rate": {
          "type": "number"
        },
        "fallback_rate": {
          "type": "number"
        },
        "risk_budget": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "fallback_evaluation": {
      "type": "object",
      "required": [
        "measured"
      ],
      "properties": {
        "measured": {
          "type": "boolean"
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eligible_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "fallback_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "fallback_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "accuracy": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "p50_latency_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "p95_latency_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "mean_tokens_processed": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "fast_confidence",
              "fast_predicted",
              "fallback_predicted",
              "gold",
              "correct",
              "latency_ms",
              "tokens_processed"
            ],
            "properties": {
              "case_id": {
                "type": "string",
                "minLength": 1
              },
              "fast_confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "fast_predicted": {
                "type": "string",
                "minLength": 1
              },
              "fallback_predicted": {
                "type": "string",
                "minLength": 1
              },
              "gold": {
                "type": "string",
                "minLength": 1
              },
              "correct": {
                "type": "boolean"
              },
              "latency_ms": {
                "type": "number",
                "minimum": 0
              },
              "tokens_processed": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "parse_valid": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        "parse_valid_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "measured": {
                "const": true
              }
            },
            "required": [
              "measured"
            ]
          },
          "then": {
            "required": [
              "adapter",
              "threshold",
              "eligible_case_count",
              "fallback_case_count",
              "fallback_rate",
              "accuracy",
              "p50_latency_ms",
              "p95_latency_ms",
              "mean_tokens_processed",
              "cases"
            ]
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
